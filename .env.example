# Copy this file to .env.local on the server and set strong values before running docker compose up

# Required for signing and verifying admin/CMS session tokens (generate a random 32+ char string)
JWT_SECRET=replace-with-a-strong-random-jwt-secret-key

# Required on first startup to seed the initial Admin (admin@esc.com) and HR (hr@esc.com) accounts
INITIAL_ADMIN_PASSWORD=replace-with-strong-admin-password
INITIAL_HR_PASSWORD=replace-with-strong-hr-password

# Optional: host port to expose the web server on (defaults to 3000)
APP_PORT=3000

